<%- include('./partials/header') %>

    <% if(success.length>0){ %>
        <div class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md bg-blue-500">
            <span class="inline-block mt-1 mb-1 text-white">
                <%= success %>
            </span>
        </div>
    <% } %>

<% const renderProductCard = function(product) { %>
    <div
        class="w-full min-w-0 rounded-md overflow-hidden transition-all duration-300 ease-in-out hover:-translate-y-1 hover:shadow-lg group">

        <div
            class="w-full h-40 flex items-center justify-center bg-[<%= product.bgcolor %>] overflow-hidden sm:h-52">
            <img class="h-32 max-w-full transition-transform duration-700 ease-in-out group-hover:scale-110 object-contain sm:h-[11rem]"
                src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                alt="<%= product.name %>">
        </div>

        <div
            class="flex items-center justify-between gap-2 bg-[<%= product.panelcolor %>] px-3 py-4 text-[<%= product.textcolor %>] sm:px-4">
            <div class="min-w-0">
                <h3 class="truncate font-medium">
                    <%= product.name %>
                </h3>
                <div class="flex items-center mt-0.5">
                    <h4 class="font-semibold">₹ <%= product.price %>
                    </h4>
                    <% if(product.discount> 0){ %>
                        <div
                            class="ml-2 rounded-3xl px-1.5 py-0.5 text-[0.8rem] text-[<%=product.panelcolor%>] bg-[<%=product.textcolor%>] font-bold">
                            -<%= product.discount %>%
                        </div>
                        <% } %>
                </div>
            </div>

            <a class="w-7 h-7 flex items-center justify-center rounded-full bg-white text-black transition-all duration-300 ease-in-out group-hover:scale-110 hover:!bg-zinc-100 active:scale-95 shadow-sm"
                href="/addtocart/<%= product._id %>">
                <i class="ri-add-line"></i>
            </a>
        </div>
    </div>
<% } %>


<div class="flex w-full min-h-[calc(100vh-70px)] flex-col items-start gap-6 px-4 pt-6 sm:px-6 lg:flex-row lg:gap-0 lg:px-10 lg:pt-10 lg:h-[calc(100vh-70px)] lg:overflow-hidden">

    <button id="sidebar-toggle" type="button" aria-controls="shop-sidebar" aria-expanded="false"
        class="fixed left-0 top-[5.5rem] z-40 flex h-11 w-11 items-center justify-center rounded-r-md bg-zinc-900 text-2xl text-white shadow-lg transition-[left] duration-300 hover:bg-zinc-700 lg:hidden">
        <span id="sidebar-toggle-icon" aria-hidden="true">&gt;</span>
        <span id="sidebar-toggle-label" class="sr-only">Open filters</span>
    </button>
    <div id="sidebar-backdrop" class="fixed inset-0 z-20 hidden bg-black/30 lg:hidden"></div>

    <!-- Left Sidebar -->
    <div id="shop-sidebar"
        class="fixed left-0 top-0 z-30 flex h-screen w-[min(18rem,85vw)] -translate-x-full flex-col items-start overflow-y-auto border-r border-zinc-200 bg-white p-5 pb-6 pt-[5.5rem] text-base shadow-xl transition-transform duration-300 ease-out sm:p-6 sm:pt-[5.5rem] sm:text-lg lg:static lg:h-full lg:w-[22%] lg:translate-x-0 lg:overflow-visible lg:border-b-0 lg:border-r lg:bg-transparent lg:p-0 lg:pl-10 lg:pr-10 lg:shadow-none lg:text-[1.3rem]">
        <div class="flex w-full flex-wrap items-center gap-2">
            <h3>sort by</h3>
            <form action="/shop">
                <select class="border-[1px] px-2 py-1" name="sortby" id="">
                    <option value="popular">Popular</option>
                    <option value="newest">Newest</option>
                </select>
            </form>
        </div>
        <div class="mt-6 flex flex-col sm:mt-10 lg:mt-20">
            <a class="block w-fit mb-2 <%= selectedCategory == 'newCollection'?'font-bold underline':'' %>"
                href="/shop/newCollection">New Collection</a>
            <a class="block w-fit mb-2 <%= selectedCategory == 'all'?'font-bold underline':'' %>"
                href="/shop">All Products</a>
            <a class="block w-fit mb-2 <%= selectedCategory == 'discounts'?'font-bold underline':'' %>"
                href="/shop/discounts">Discounted Products</a>
        </div>
        <div class="mt-6 lg:mt-32">
            <h3 class="block w-fit mb-2" href="">Filter by :</h3>
            <a class="block w-fit mb-2" href="/shop">Availability</a>
            <a class="block w-fit mb-2" href="/shop/discounts">Discount</a>
        </div>
    </div>
    <!-- Products Container -->
    <div class="flex w-full flex-col content-start gap-5 pb-10 lg:h-full lg:w-[78%] lg:overflow-y-auto lg:pl-10 scrollbar-thin scrollbar-thumb-zinc-300 scrollbar-track-transparent hover:scrollbar-thumb-zinc-400">

        <!-- Section 1: New Collection -->
        <% if(selectedCategory == 'all' || selectedCategory == 'newCollection'){ %>
        <div>
            <h2 class="text-2xl font-semibold mb-4 text-zinc-800">New Collection</h2>
            <div class="grid grid-cols-2 items-start gap-4 sm:grid-cols-3 sm:gap-5 xl:grid-cols-4">
                <% newCollection.forEach((product) => { %>
                    <% renderProductCard(product); %>
                <% }) %>
            </div>
        </div>
        <% } %>

        <!-- Section 2: Browse Products -->
        <% if(selectedCategory == 'all' || selectedCategory == 'discounts'){ %>
        <div>
            <h2 class="text-2xl font-semibold mb-4 text-zinc-800">Browse Products</h2>
            <div class="grid grid-cols-2 items-start gap-4 sm:grid-cols-3 sm:gap-5 xl:grid-cols-4">
                <% browseProducts.forEach((product) => { %>
                    <% renderProductCard(product); %>
                <% }) %>
            </div>
        </div>
        <% } %>

        <!-- If required products are not present -->
        <% if(selectedCategory === 'newCollection' && newCollection.length == 0) { %>
            <p class="text-zinc-500 text-lg">No new collection products found.</p>
        <% } %>

        <% if(selectedCategory === 'discounts' && products.length == 0) { %>
            <p class="text-zinc-500 text-lg">No discounted products found.</p>
        <% } %>

    </div>
</div>

<script>
    const sidebarToggle = document.getElementById('sidebar-toggle');
    const sidebar = document.getElementById('shop-sidebar');
    const sidebarBackdrop = document.getElementById('sidebar-backdrop');
    const sidebarToggleIcon = document.getElementById('sidebar-toggle-icon');
    const sidebarToggleLabel = document.getElementById('sidebar-toggle-label');

    function setSidebarOpen(isOpen) {
        sidebar.classList.toggle('-translate-x-full', !isOpen);
        sidebar.classList.toggle('translate-x-0', isOpen);
        sidebarToggle.classList.toggle('left-0', !isOpen);
        sidebarToggle.classList.toggle('left-[min(18rem,85vw)]', isOpen);
        sidebarBackdrop.classList.toggle('hidden', !isOpen);
        sidebarToggle.setAttribute('aria-expanded', String(isOpen));
        sidebarToggleIcon.textContent = isOpen ? '<' : '>';
        sidebarToggleLabel.textContent = isOpen ? 'Close filters' : 'Open filters';
        document.body.classList.toggle('overflow-hidden', isOpen);
    }

    sidebarToggle.addEventListener('click', () => {
        setSidebarOpen(sidebarToggle.getAttribute('aria-expanded') !== 'true');
    });
    sidebarBackdrop.addEventListener('click', () => setSidebarOpen(false));
    window.addEventListener('resize', () => {
        if (window.innerWidth >= 1024) setSidebarOpen(false);
    });
</script>

<style>
        .overflow-y-auto::-webkit-scrollbar {
            width: 6px;
        }

        .overflow-y-auto::-webkit-scrollbar-track {
            background: transparent;
        }

        .overflow-y-auto::-webkit-scrollbar-thumb {
            background-color: #e4e4e7;
            border-radius: 10px;
        }

        .overflow-y-auto::-webkit-scrollbar-thumb:hover {
            background-color: #d4d4d8;
        }
    </style>

    <%- include('./partials/footer') %>