<%- include('./partials/header') %>
    <div class="flex min-h-screen w-full flex-col items-start gap-8 px-5 py-8 sm:px-10 lg:flex-row lg:px-20 lg:py-20">
        <div class="flex w-full flex-col items-start lg:h-screen lg:w-[22%]">
            <div class="flex flex-col">
                <a class="block w-fit mb-2" href="">All Products</a>
                <a class="block w-fit mb-2" href="/owners/createproduct">Create new product</a>
            </div>
        </div>
        <div class="flex w-full flex-col gap-5 lg:h-screen lg:w-[78%]">
            <a class="text-red-500" href="">Delete all</a>
            <div class="grid grid-cols-2 items-start gap-4 pb-10 sm:grid-cols-3 sm:gap-5 xl:grid-cols-4">
                        <% products.forEach(function(product){ %>
                            <div class="w-full min-w-0">
                                <div class="w-full h-52 flex items-center justify-center bg-[<%= product.bgcolor %>]">
                                    <img class="h-32 max-w-full sm:h-[11rem]"
                                        src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="">
                                </div>
                                <div
                                    class="flex items-center justify-between gap-2 bg-[<%= product.panelcolor %>] px-3 py-4 text-[<%= product.textcolor %>] sm:px-4">
                                    <div class="min-w-0">
                                        <h3 class="truncate">
                                            <%= product.name %>
                                        </h3>
                                        <div class="flex">
                                            <h4>₹ <%= product.price %>
                                            </h4>
                                            <% if(product.discount>0){ %>
                                                <div class="ml-2 rounded-3xl px-1.5 py-0.5 text-[0.8rem] text-[<%=product.panelcolor%>] bg-[<%=product.textcolor%>]">
                                                    -<%=product.discount%>%
                                                </div>
                                                <% } %>
                                        </div>

                                    </div>
                                    <a class="w-7 h-7 flex items-center justify-center rounded-full bg-white"
                                        href="/addtocart/<%= product._id %>">
                                        <i class="ri-add-line"></i>
                                    </a>
                                </div>
                            </div>
                            <% }) %>
            </div>
        </div>
    </div>
    <%- include('./partials/footer') %>