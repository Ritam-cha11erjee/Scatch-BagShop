<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scatch</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        hr {
            border: 2px solid gray;
        }
    </style>
</head>

<body class="overflow-x-hidden pt-[4.5rem] font-['helvetica_now_display'] lg:pt-0">
    <nav class="fixed left-0 top-0 z-50 flex w-full flex-wrap items-center justify-between gap-3 bg-white px-4 py-3 sm:px-6 lg:static">
        <h3 class="text-2xl sm:text-3xl">Scatch</h3>
        <% var loggedin=typeof loggedin !=="undefined" ? loggedin : true %>
            <% if(loggedin) { %>

                <div class="flex items-center gap-4 text-lg sm:gap-7 sm:text-2xl">
                    <a href="/shop">Shop</a>
                    <a href="/cart">Cart</a>
                    <!-- <a href="/shop">My Account</a> -->
                    <a class="text-red-600" href="/logout">Logout</a>
                </div>
                <% } %>
    </nav>
    <hr>